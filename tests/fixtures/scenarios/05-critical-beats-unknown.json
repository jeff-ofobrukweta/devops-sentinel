{
  "description": "critical CPU while disk cannot be read",
  "probe": {
    "cpu": [[{ "idle": 0, "busy": 0 }], [{ "idle": 50, "busy": 950 }]],
    "disks": { "/": { "error": "EACCES: permission denied" } }
